{
  "manifest_version": 3,
  "minimum_chrome_version": "102",
  "name": "ReSo Ekstention",
  "description": "Ambil nama komentator dari Facebook, TikTok & Instagram, lalu kirim otomatis ke rekap web app ReSo.",
  "version": "1.0.57",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_title": "ReSo Ekstensi",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "options_page": "options.html",
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "permissions": [
    "storage",
    "scripting",
    "tabs",
    "webRequest",
    "cookies",
    "alarms"
  ],
  "externally_connectable": {
    "matches": [
      "https://reso.sekretariat.fun/*",
      "http://localhost:3000/*"
    ]
  },
  "commands": {
    "run-extract": {
      "suggested_key": {
        "default": "Ctrl+Shift+E"
      },
      "description": "ReSo \u2014 Proses / ambil nama komentator di tab aktif"
    }
  },
  "host_permissions": [
    "https://www.facebook.com/*",
    "https://web.facebook.com/*",
    "https://m.facebook.com/*",
    "https://facebook.com/*",
    "*://*.facebook.com/*",
    "*://*.tiktok.com/*",
    "*://*.instagram.com/*",
    "https://reso.sekretariat.fun/*"
  ],
  "content_scripts": [
    {
      "matches": [
        "https://www.facebook.com/*",
        "https://web.facebook.com/*",
        "https://m.facebook.com/*",
        "https://facebook.com/*",
        "*://*.facebook.com/*"
      ],
      "js": [
        "shared.js",
        "content-fb.js"
      ],
      "css": [
        "content-fb.css"
      ],
      "run_at": "document_start"
    },
    {
      "matches": [
        "*://*.tiktok.com/*"
      ],
      "js": [
        "shared.js",
        "content-tiktok.js"
      ],
      "css": [
        "content-tiktok.css"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "*://*.instagram.com/*"
      ],
      "js": [
        "shared.js",
        "content-ig.js"
      ],
      "css": [
        "content-ig.css"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://reso.sekretariat.fun/*",
        "http://localhost:3000/*"
      ],
      "js": [
        "content-reso.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "key": ""
}