// ===============================================================
// ReSo Firestore Security Rules
// Align with src/types.ts (Employee dual accounts + TikTok fields)
// ===============================================================

rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // 0. Global Safety Net: Default Deny All
    match /{document=**} {
      allow read, write: if false;
    }

    // 1. Primitive Helpers
    function isSignedIn() {
      return request.auth != null && request.auth.token.email_verified == true;
    }

    function isAuthorized() {
      let allowedEmails = [
        'ngerjaindiri@gmail.com',
        'sipencil@gmail.com',
        'abiemputra.asn@gmail.com'
      ];
      return isSignedIn() && (
        request.auth.token.email in allowedEmails ||
        exists(/databases/$(database)/documents/admins/$(request.auth.uid))
      );
    }

    function isAdmin() {
      return isAuthorized();
    }

    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() { return request.resource.data; }
    function existing() { return resource.data; }

    function optionalString(data, key, maxLen) {
      return !(key in data) || (data[key] is string && data[key].size() <= maxLen);
    }

    function optionalStringList(data, key, maxItems, maxItemLen) {
      return !(key in data) || (
        data[key] is list &&
        data[key].size() <= maxItems &&
        data[key].all(v => v is string && v.size() <= maxItemLen)
      );
    }

    function optionalIdList(data, key) {
      return !(key in data) || (
        data[key] is list &&
        data[key].size() <= 500 &&
        data[key].all(v => v is string && v.size() > 0 && v.size() <= 128)
      );
    }

    function optionalTimestamp(data, key) {
      return !(key in data) || data[key] is timestamp;
    }

    // Antrian "nama belum terpetakan" (ditulis dashboard + API ReSoEx):
    // list { name: string, platform: 'ig'|'fb'|'tiktok' }. Batas sengaja
    // sangat longgar — raw text sendiri sudah dibatasi 50000 karakter,
    // jadi aturan ini fokus ke tipe, bukan menolak paste legit.
    function isValidUnmatchedNames(data) {
      return !('unmatchedNames' in data) || (
        data.unmatchedNames is list &&
        data.unmatchedNames.size() <= 50000 &&
        data.unmatchedNames.all(u =>
          u is map &&
          u.name is string &&
          u.platform is string &&
          u.platform in ['ig', 'fb', 'tiktok']
        )
      );
    }

    // Waktu posting dari ReSoEx (L3): ISO lokal "YYYY-MM-DDTHH:MM" (boleh
    // + detik) — cermin isValidPostedAt di src/lib/engagement-api.ts.
    function optionalPostedAt(data) {
      return !('postedAt' in data) || (
        data.postedAt is list &&
        data.postedAt.size() <= 100 &&
        data.postedAt.all(t =>
          t is string &&
          t.size() <= 19 &&
          t.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}(:[0-9]{2})?$')
        )
      );
    }

    // 2. Validation Blueprints

    function isValidUser(data) {
      return (!('role' in data) || (data.role is string && data.role in ['user', 'admin']));
    }

    function isValidEmployee(data) {
      return data.keys().hasAll(['name', 'nip']) &&
             data.name is string && data.name.size() > 0 && data.name.size() < 100 &&
             data.nip is string && data.nip.size() > 0 && data.nip.size() < 50 &&
             optionalString(data, 'bidang', 100) &&
             optionalString(data, 'igUsername', 50) &&
             optionalString(data, 'igUsername2', 50) &&
             optionalString(data, 'fbName', 100) &&
             optionalString(data, 'fbName2', 100) &&
             optionalString(data, 'tiktokName', 100) &&
             optionalString(data, 'tiktokName2', 100) &&
             // Alias hasil pemetaan admin (antrian belum terpetakan) — list string.
             optionalStringList(data, 'aliases', 500, 200) &&
             (!('createdAt' in data) || data.createdAt is timestamp) &&
             (!('updatedAt' in data) || data.updatedAt is timestamp);
    }

    // Raw text limit raised for large staff lists (still bounded)
    function isValidDailyEngagement(data) {
      return data.keys().hasAll(['date']) &&
             data.date is string && data.date.size() == 10 &&
             data.date.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$') &&
             optionalString(data, 'igRawText', 50000) &&

             optionalString(data, 'fbRawText', 50000) &&
             optionalString(data, 'tiktokRawText', 50000) &&
             optionalStringList(data, 'igLinks', 100, 2000) &&
             optionalStringList(data, 'fbLinks', 100, 2000) &&
             optionalStringList(data, 'tiktokLinks', 100, 2000) &&
             optionalIdList(data, 'igEngagedEmployeeIds') &&
             optionalIdList(data, 'fbEngagedEmployeeIds') &&
             optionalIdList(data, 'tiktokEngagedEmployeeIds') &&
             // Penanda ReSoEx (L3): waktu isi otomatis, jumlah nama baru, review operator.
             optionalTimestamp(data, 'autoFilledAt') &&
             (!('autoFilledCount' in data) || (data.autoFilledCount is int && data.autoFilledCount >= 0 && data.autoFilledCount <= 100000)) &&
             optionalTimestamp(data, 'verifiedAt') &&
             isValidUnmatchedNames(data) &&
             // Waktu posting dari ReSoEx (L3) — daftar ISO lokal, max 100 per hari.
             optionalPostedAt(data) &&
             optionalTimestamp(data, 'updatedAt');
    }
    
    function isValidSetting(data) {
      return (!('value' in data) || (data.value is string && data.value.size() <= 5000000)) &&
             (!('updatedAt' in data) || data.updatedAt is timestamp);
    }

    // 3. Collection Rules

    match /users/{userId} {
      allow read: if isAuthorized() && request.auth.uid == userId;
      allow create: if isAuthorized() && request.auth.uid == userId && isValidUser(incoming());
      allow update: if isAuthorized() && request.auth.uid == userId && isValidUser(incoming()) && 
                       (!('role' in incoming()) || incoming().role == existing().role);
      allow delete: if isAdmin();
    }

    match /admins/{adminId} {
      allow read: if isAuthorized();
      allow create, update: if isAdmin() && isValidId(adminId) && 
                            incoming().keys().hasAll(['email']) && 
                            incoming().email is string && incoming().email.size() > 0 && incoming().email.size() < 100 &&
                            (!('name' in incoming()) || (incoming().name is string && incoming().name.size() < 100)) &&
                            (!('addedAt' in incoming()) || incoming().addedAt is timestamp);
      allow delete: if isAdmin() && isValidId(adminId);
    }

    match /employees/{employeeId} {
      allow list, get: if isAuthorized();
      allow create: if isAdmin() && isValidId(employeeId) && isValidEmployee(incoming());
      allow update: if isAdmin() && isValidId(employeeId) && isValidEmployee(incoming());
      allow delete: if isAdmin() && isValidId(employeeId);
    }

    match /dailyEngagement/{dateId} {
      allow list, get: if isAuthorized();
      allow create: if isAdmin() && isValidId(dateId) && isValidDailyEngagement(incoming());
      allow update: if isAdmin() && isValidId(dateId) && isValidDailyEngagement(incoming());
      allow delete: if isAdmin() && isValidId(dateId);
    }

    match /settings/{settingId} {
      allow list: if isAuthorized();
      allow get: if isAuthorized() || settingId == 'appLogo';
      allow create: if isAdmin() && isValidId(settingId) && isValidSetting(incoming());
      allow update: if isAdmin() && isValidId(settingId) && isValidSetting(incoming());
      allow delete: if isAdmin() && isValidId(settingId);
    }
  }
}
