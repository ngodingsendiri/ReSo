// ===============================================================
// ReSo Firestore Security Rules
// Model MULTI-TENANT single-database (Spark/gratis):
//  - 1 project, 1 database `(default)`. Tiap dinas/user = subtree
//    `dinas/<uid>` — data TIDAK bercampur karena rules membatasi akses
//    hanya ke `dinas/{request.auth.uid}`.
//  - Super-admin (allowlist email) boleh akses semua dinas.
//  - Ekstensi menulis via API (api/engagement.ts) ke `dinas/<uid>/...`.
// JAGA SINKRON: allowlist email di sini (`isSuperAdmin`) dicerminkan di
// `src/lib/engagement-api.ts` (`ADMIN_EMAILS`) — drift dicegah test
// `src/lib/engagement-api.test.ts` (PARITY) via `npm run test:api`.
// ===============================================================

rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // 0. Global Safety Net: Default Deny All
    match /{document=**} {
      allow read, write: if false;
    }

    // 1. Primitive Helpers
    function isSignedIn() {
      return request.auth != null && request.auth.token.email_verified == true;
    }

    function isSuperAdmin() {
      let allowedEmails = [
        'ngerjaindiri@gmail.com',
        'sipencil@gmail.com',
        'abiemputra.asn@gmail.com'
      ];
      return request.auth != null && request.auth.token.email in allowedEmails;
    }

    // Akses ke subtree dinas: pemilik uid (lowercase) ATAU super-admin.
    function isAllowedDinas(dinasUid) {
      return isSignedIn() && (request.auth.uid.lower() == dinasUid.lower() || isSuperAdmin());
    }

    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() { return request.resource.data; }
    function existing() { return resource.data; }

    function optionalString(data, key, maxLen) {
      return !(key in data) || (data[key] is string && data[key].size() <= maxLen);
    }

    function optionalStringList(data, key, maxItems) {
      return !(key in data) || (
        data[key] is list &&
        data[key].size() <= maxItems
      );
    }

    function optionalIdList(data, key) {
      return !(key in data) || (
        data[key] is list &&
        data[key].size() <= 500
      );
    }

    // 2. Validation Blueprints

    function isValidUser(data) {
      return (!('role' in data) || (data.role is string && data.role in ['user', 'admin']));
    }

    function isValidEmployee(data) {
      return data.keys().hasAll(['name', 'nip']) &&
             data.name is string && data.name.size() > 0 && data.name.size() < 100 &&
             data.nip is string && data.nip.size() > 0 && data.nip.size() < 50 &&
             optionalString(data, 'bidang', 100) &&
             optionalString(data, 'igUsername', 50) &&
             optionalString(data, 'igUsername2', 50) &&
             optionalString(data, 'fbName', 100) &&
             optionalString(data, 'fbName2', 100) &&
             optionalString(data, 'tiktokName', 100) &&
             optionalString(data, 'tiktokName2', 100) &&
             (!('createdAt' in data) || data.createdAt is timestamp) &&
             (!('updatedAt' in data) || data.updatedAt is timestamp);
    }

    // Raw text limit raised for large staff lists (still bounded)
    function isValidDailyEngagement(data) {
      return data.keys().hasAll(['date']) &&
             data.date is string && data.date.size() == 10 &&
             data.date.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$') &&
             optionalString(data, 'igRawText', 50000) &&
             optionalString(data, 'fbRawText', 50000) &&
             optionalString(data, 'tiktokRawText', 50000) &&
             optionalStringList(data, 'igLinks', 100) &&
             optionalStringList(data, 'fbLinks', 100) &&
             optionalStringList(data, 'tiktokLinks', 100) &&
             optionalIdList(data, 'igEngagedEmployeeIds') &&
             optionalIdList(data, 'fbEngagedEmployeeIds') &&
             optionalIdList(data, 'tiktokEngagedEmployeeIds') &&
             optionalStringList(data, 'postedAt', 100) &&
             optionalStringList(data, 'unmatchedNames', 1000) &&
             (!('updatedAt' in data) || data.updatedAt is timestamp);
    }

    function isValidSetting(data) {
      return (!('value' in data) || (data.value is string && data.value.size() <= 5000000)) &&
             (!('updatedAt' in data) || data.updatedAt is timestamp);
    }

    // 3. Top-level users (login tracking) — hanya untuk diri sendiri
    match /users/{userId} {
      allow read: if isSignedIn() && request.auth.uid == userId;
      allow create: if isSignedIn() && request.auth.uid == userId && isValidUser(incoming());
      allow update: if isSignedIn() && request.auth.uid == userId && isValidUser(incoming()) &&
                       (!('role' in incoming()) || incoming().role == existing().role);
      allow delete: if isSuperAdmin();
    }

    // 4. Subtree per dinas: dinas/{uid}/...
    match /dinas/{dinasUid}/admins/{adminId} {
      allow read: if isAllowedDinas(dinasUid);
      allow create, update: if isAllowedDinas(dinasUid) && isValidId(adminId) &&
                            incoming().keys().hasAll(['email']) &&
                            incoming().email is string && incoming().email.size() > 0 && incoming().email.size() < 100 &&
                            (!('name' in incoming()) || (incoming().name is string && incoming().name.size() < 100)) &&
                            (!('addedAt' in incoming()) || incoming().addedAt is timestamp);
      allow delete: if isAllowedDinas(dinasUid) && isValidId(adminId);
    }

    match /dinas/{dinasUid}/employees/{employeeId} {
      allow list, get: if isAllowedDinas(dinasUid);
      allow create: if isAllowedDinas(dinasUid) && isValidId(employeeId) && isValidEmployee(incoming());
      allow update: if isAllowedDinas(dinasUid) && isValidId(employeeId) && isValidEmployee(incoming());
      allow delete: if isAllowedDinas(dinasUid) && isValidId(employeeId);
    }

    match /dinas/{dinasUid}/dailyEngagement/{dateId} {
      allow list, get: if isAllowedDinas(dinasUid);
      allow create: if isAllowedDinas(dinasUid) && isValidId(dateId) && isValidDailyEngagement(incoming());
      allow update: if isAllowedDinas(dinasUid) && isValidId(dateId) && isValidDailyEngagement(incoming());
      allow delete: if isAllowedDinas(dinasUid) && isValidId(dateId);
    }

    match /dinas/{dinasUid}/settings/{settingId} {
      allow list: if isAllowedDinas(dinasUid);
      allow get: if isAllowedDinas(dinasUid) || settingId == 'appLogo';
      allow create: if isAllowedDinas(dinasUid) && isValidId(settingId) && isValidSetting(incoming());
      allow update: if isAllowedDinas(dinasUid) && isValidId(settingId) && isValidSetting(incoming());
      allow delete: if isAllowedDinas(dinasUid) && isValidId(settingId);
    }

    match /dinas/{dinasUid}/users/{userId} {
      allow read: if isAllowedDinas(dinasUid) && request.auth.uid == userId;
      allow create: if isAllowedDinas(dinasUid) && request.auth.uid == userId && isValidUser(incoming());
      allow update: if isAllowedDinas(dinasUid) && request.auth.uid == userId && isValidUser(incoming()) &&
                       (!('role' in incoming()) || incoming().role == existing().role);
      allow delete: if isSuperAdmin();
    }
  }
}
